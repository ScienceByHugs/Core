# Copy to .env.local. Staging only: the app refuses production projects and keys.
EXPO_PUBLIC_APP_ENV=staging
EXPO_PUBLIC_SUPABASE_URL=https://REPLACE_WITH_STAGING_PROJECT_REF.supabase.co
EXPO_PUBLIC_EXPECTED_SUPABASE_REF=REPLACE_WITH_STAGING_PROJECT_REF
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_STAGING_PUBLISHABLE_KEY

# Keep false until the staged payment-control backend and synthetic flows are verified.
EXPO_PUBLIC_ENABLE_TEST_PAYMENTS=false

# Keep false until synthetic staging backends and outbound targets are verified.
EXPO_PUBLIC_ENABLE_ADMIN_WRITES=false
EXPO_PUBLIC_ENABLE_TEST_MESSAGES=false
# Synthetic staging tester addresses only; no production customer list.
EXPO_PUBLIC_TEST_RECIPIENT_EMAILS=
# Activation requests also require this exact approved staging origin.
EXPO_PUBLIC_NEXUS_STAGING_ORIGIN=https://sbh-nexus-v2-staging.pages.dev
